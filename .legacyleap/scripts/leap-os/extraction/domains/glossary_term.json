{
  "domain_key": "glossary_term",
  "item_type": "GlossaryTerm",
  "dataset_key": "glossary_term",
  "key_prefix": "gl",
  "extraction_query": "Extract domain-specific terms that stakeholders need defined consistently. A glossary term is vocabulary used across the application — business nouns, acronyms, role names, process names, or technical labels. For each term provide a clear definition, usage context, and related term keys. When other domains are already extracted, prefer terms named by those items.",
  "categories": [
    { "key": "business_term", "name": "Business Terms" },
    { "key": "acronym", "name": "Acronyms" },
    { "key": "role_term", "name": "Role Terms" },
    { "key": "process_term", "name": "Process Terms" },
    { "key": "technical_term", "name": "Technical Terms" }
  ],
  "item_fields": [
    "definition",
    "usage_context",
    "related_term_keys"
  ],
  "evidence_roles": ["DEFINES", "USES"],
  "discovery": {
    "seed_phrases": [
      "domain terminology acronym",
      "business glossary term",
      "project specific abbreviation"
    ],
    "component_filters": ["model", "service", "form", "module"],
    "mcp_discovery_tools": [
      "mcm_search_components_fulltext",
      "mcm_map_business_domains"
    ],
    "candidate_limit_per_query": 15,
    "max_unique_candidates": 60,
    "batch_size": 10,
    "harvest_from_domains": true
  },
  "relates_to": []
}
