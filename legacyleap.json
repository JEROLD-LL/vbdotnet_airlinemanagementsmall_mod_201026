{
  "$schema": "embedded",
  "model": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
  "extensions": {
    "fsd": true
  },
  "tui": {
    "scroll_speed": 6,
    "scroll_acceleration": {
      "enabled": false
    }
  },
  "mcp": {
    "neo4j-modeling": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "mcp-neo4j-data-modeling@0.1.1"
      ]
    },
    "neo4j-cypher": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "mcp-neo4j-cypher"
      ],
      "environment": {
        "NEO4J_URI": "{env:NEO4J_URI:-bolt://localhost:7687}",
        "NEO4J_USERNAME": "{env:NEO4J_USERNAME:-neo4j}",
        "NEO4J_PASSWORD": "{env:NEO4J_PASSWORD}",
        "NEO4J_DATABASE": "{env:NEO4J_DATABASE:-neo4j}"
      }
    }
  },
  "permission": {
    "external_directory": {
      "~/tmp/**": "allow",
      "/tmp/*": "allow"
    },
    "edit": {
      "~/tmp/**": "allow",
      "/tmp/*": "allow"
    }
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 120000
      }
    },
    "anthropic": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 120000
      }
    }
  }
}
