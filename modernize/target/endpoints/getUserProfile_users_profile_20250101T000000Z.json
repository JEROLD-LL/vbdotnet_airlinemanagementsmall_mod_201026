{
  "openapi": "3.0.3",
  "info": {
    "title": "Airline Management API - User Profile",
    "description": "OpenAPI definition for the user profile endpoint migrated from the legacy VB.NET ProfileForm.LoadProfile method. Supports Markdown (CommonMark).",
    "version": "1.0.0",
    "license": {
      "name": "Proprietary",
      "url": "https://example.com/license"
    }
  },
  "externalDocs": {
    "description": "Legacy source reference: Forms/ProfileForm.vb (LoadProfile), Services/SessionManager.vb (IsAuthenticated), Repositories/UserRepository.vb (GetById)",
    "url": "https://example.com/docs/airline-management"
  },
  "servers": [
    {
      "url": "https://api.example.com/{basePath}",
      "description": "Airline Management API server",
      "variables": {
        "basePath": {
          "default": "v1",
          "description": "API base path version"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Users",
      "description": "User account and profile operations",
      "externalDocs": {
        "description": "User profile documentation",
        "url": "https://example.com/docs/airline-management/users"
      }
    }
  ],
  "paths": {
    "/users/profile": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get the authenticated user's profile",
        "description": "Returns the profile of the currently authenticated user. Migrated from the legacy `ProfileForm.LoadProfile` method, which read `SessionManager.CurrentUser.Id`, loaded the user via `UserRepository.GetById`, and displayed Username, Email, FullName and CreatedAt (formatted `yyyy-MM-dd HH:mm:ss`). The password is never returned. Requires a valid Bearer token; the legacy 'Please login first.' check maps to a 401 response.",
        "operationId": "getUserProfile(Forms.ProfileForm.ProfileForm.LoadProfile.0)",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "Bearer token of the authenticated user (format: 'Bearer <token>')",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIn0.signature"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "username",
                    "email",
                    "fullName",
                    "createdAt"
                  ],
                  "properties": {
                    "username": {
                      "type": "string",
                      "example": "john_doe"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "example": "john@example.com"
                    },
                    "fullName": {
                      "type": "string",
                      "example": "John Doe"
                    },
                    "createdAt": {
                      "type": "string",
                      "description": "Account creation timestamp in legacy display format yyyy-MM-dd HH:mm:ss",
                      "example": "2025-01-15 10:30:00"
                    }
                  }
                },
                "example": {
                  "username": "john_doe",
                  "email": "john@example.com",
                  "fullName": "John Doe",
                  "createdAt": "2025-01-15 10:30:00"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized. No authenticated user session (legacy: 'Please login first.')",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 401
                    },
                    "error": {
                      "type": "string",
                      "example": "Unauthorized"
                    },
                    "message": {
                      "type": "string",
                      "example": "Please login first."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "User not found (legacy: 'User not found.')",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 404
                    },
                    "error": {
                      "type": "string",
                      "example": "Not Found"
                    },
                    "message": {
                      "type": "string",
                      "example": "User not found."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Bearer token issued on login, replacing the legacy in-process SessionManager session"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
