{
  "openapi": "3.0.3",
  "info": {
    "title": "Airline Management API - My Bookings",
    "description": "Endpoint migrated from the legacy VB.NET MyBookingsForm.LoadBookings routine. Returns the bookings of the currently authenticated user, each enriched with its flight details. Source qualified name: Forms.MyBookingsForm.MyBookingsForm.LoadBookings.0",
    "version": "1.0.0",
    "license": {
      "name": "Proprietary",
      "url": "https://example.com/license"
    }
  },
  "externalDocs": {
    "description": "Legacy source reference and migration notes",
    "url": "https://example.com/docs/airline-management-migration"
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Primary API server"
    }
  ],
  "tags": [
    {
      "name": "Bookings",
      "description": "Operations for managing flight bookings"
    }
  ],
  "paths": {
    "/users/me/bookings": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "Get bookings for the current user",
        "description": "Retrieves all flight bookings belonging to the authenticated user, ordered by booking date descending (newest first). For each booking the associated flight is looked up and its flight number, route (origin → destination), departure date, departure time, arrival time and price are included. Seat number defaults to \"N/A\" when the booking has no seat assigned. Legacy behavior: if the user is not authenticated the legacy form shows a 'Please login first.' message and closes; the API equivalent returns 401.",
        "externalDocs": {
          "description": "Legacy source: MyBookingsForm.LoadBookings",
          "url": "https://example.com/docs/legacy/MyBookingsForm#LoadBookings"
        },
        "operationId": "loadBookings(Forms.MyBookingsForm.MyBookingsForm.LoadBookings.0)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "Bearer token identifying the logged-in user (replaces SessionManager.CurrentUser).",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.signature"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of bookings for the authenticated user. An empty array is returned when the user has no bookings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MyBooking"
                  }
                },
                "example": [
                  {
                    "id": 101,
                    "flightId": 12,
                    "flightNumber": "AM-204",
                    "route": "New York (JFK) → London (LHR)",
                    "departureDate": "2026-03-15",
                    "departureTime": "08:30",
                    "arrivalTime": "20:45",
                    "passengerName": "Jane Doe",
                    "passengerEmail": "jane.doe@example.com",
                    "seatNumber": "12A",
                    "price": 549.99,
                    "bookingDate": "2026-02-01 14:22"
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Unauthorized. The request has no valid authentication token, or the user session is not authenticated (legacy: 'Please login first.').",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "NOT_AUTHENTICATED",
                  "message": "Please login first."
                }
              }
            }
          },
          "403": {
            "description": "Forbidden. The authenticated principal is not allowed to access bookings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "FORBIDDEN",
                  "message": "Access to bookings is not permitted for this user."
                }
              }
            }
          },
          "500": {
            "description": "Internal server error while reading bookings or flight data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "INTERNAL_ERROR",
                  "message": "An unexpected error occurred while loading bookings."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT bearer token for the authenticated user."
      }
    },
    "schemas": {
      "MyBooking": {
        "type": "object",
        "description": "A booking of the current user combined with its flight details.",
        "required": [
          "id",
          "flightId",
          "flightNumber",
          "route",
          "departureDate",
          "departureTime",
          "arrivalTime",
          "passengerName",
          "passengerEmail",
          "seatNumber",
          "price",
          "bookingDate"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Booking identifier (legacy Booking.Id).",
            "example": 101
          },
          "flightId": {
            "type": "integer",
            "format": "int32",
            "description": "Identifier of the booked flight (legacy Booking.FlightId).",
            "example": 12
          },
          "flightNumber": {
            "type": "string",
            "description": "Flight number (legacy Flight.FlightNumber).",
            "example": "AM-204"
          },
          "route": {
            "type": "string",
            "description": "Route built as '{Origin} → {Destination}' from the flight.",
            "example": "New York (JFK) → London (LHR)"
          },
          "departureDate": {
            "type": "string",
            "format": "date",
            "description": "Flight departure date, formatted yyyy-MM-dd.",
            "example": "2026-03-15"
          },
          "departureTime": {
            "type": "string",
            "description": "Flight departure time, formatted HH:mm (legacy 'hh\\:mm').",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "example": "08:30"
          },
          "arrivalTime": {
            "type": "string",
            "description": "Flight arrival time, formatted HH:mm (legacy 'hh\\:mm').",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "example": "20:45"
          },
          "passengerName": {
            "type": "string",
            "description": "Passenger name stored on the booking.",
            "example": "Jane Doe"
          },
          "passengerEmail": {
            "type": "string",
            "format": "email",
            "description": "Passenger email stored on the booking.",
            "example": "jane.doe@example.com"
          },
          "seatNumber": {
            "type": "string",
            "description": "Assigned seat number. Returns \"N/A\" when the booking has no seat.",
            "example": "12A"
          },
          "price": {
            "type": "number",
            "format": "double",
            "description": "Flight price (legacy Flight.Price, decimal). Displayed as currency in legacy UI.",
            "example": 549.99
          },
          "bookingDate": {
            "type": "string",
            "description": "Booking date-time formatted yyyy-MM-dd HH:mm.",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$",
            "example": "2026-02-01 14:22"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "NOT_AUTHENTICATED"
          },
          "message": {
            "type": "string",
            "example": "Please login first."
          }
        }
      }
    }
  }
}
