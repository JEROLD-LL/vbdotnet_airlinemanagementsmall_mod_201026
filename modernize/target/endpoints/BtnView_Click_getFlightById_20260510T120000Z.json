{
  "openapi": "3.0.3",
  "info": {
    "title": "Airline Management API - Flights",
    "description": "Migrated endpoint derived from the legacy VB.NET FlightsForm.BtnView_Click handler. Retrieves a single flight's details for the 'View Details' action on the Available Flights screen.",
    "version": "1.0.0",
    "license": {
      "name": "Proprietary",
      "url": "https://example.com/license"
    }
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Primary API server"
    }
  ],
  "tags": [
    {
      "name": "Flights",
      "description": "Flight schedule and details operations"
    }
  ],
  "paths": {
    "/flights/{flightId}": {
      "get": {
        "tags": ["Flights"],
        "summary": "Get flight details by ID",
        "description": "Returns the details of a single flight identified by its ID. Corresponds to the legacy 'View Details' button in FlightsForm, where the flight ID is read from the selected grid row (Id column) and passed to ViewFlightForm, which loads it through FlightRepository.GetById. If no flight matches the ID, the legacy code shows 'Flight not found.' and closes the view; this endpoint returns 404 instead. Legacy code performs no authentication check on this action; the bearer token requirement is a modernization addition consistent with other endpoints.",
        "operationId": "getFlightById(Forms.FlightsForm.FlightsForm.BtnView_Click.2.Object.EventArgs)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "flightId",
            "in": "path",
            "description": "Unique identifier of the flight (legacy Flight.Id). Corresponds to the Id value of the selected row in the flights grid.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            },
            "example": 101
          }
        ],
        "responses": {
          "200": {
            "description": "Flight details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightDetails"
                },
                "example": {
                  "id": 101,
                  "flightNumber": "AM-101",
                  "origin": "NYC",
                  "destination": "LAX",
                  "departureDate": "2026-05-15",
                  "departureTime": "08:30",
                  "arrivalTime": "11:45",
                  "price": 299.99,
                  "availableSeats": 42,
                  "createdAt": "2026-01-10T09:00:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Invalid flight ID (for example, a non-integer or a value below 1). Legacy equivalent: no flight selected ('Please select a flight.').",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Bad Request",
                  "message": "Please select a flight."
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized. Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Unauthorized",
                  "message": "Authentication is required."
                }
              }
            }
          },
          "403": {
            "description": "Forbidden. The authenticated user is not permitted to view this flight.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Forbidden",
                  "message": "You do not have permission to view this flight."
                }
              }
            }
          },
          "404": {
            "description": "Flight not found. Legacy equivalent: FlightRepository.GetById returned no record ('Flight not found.').",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Not Found",
                  "message": "Flight not found."
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Internal Server Error",
                  "message": "An unexpected error occurred."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "FlightDetails": {
        "type": "object",
        "description": "Flight record mapped from the legacy Flight model.",
        "required": ["id", "flightNumber", "origin", "destination", "departureDate", "departureTime", "arrivalTime", "price", "availableSeats", "createdAt"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Flight identifier (legacy Flight.Id)."
          },
          "flightNumber": {
            "type": "string",
            "description": "Flight number (legacy Flight.FlightNumber)."
          },
          "origin": {
            "type": "string",
            "description": "Origin airport or city (legacy Flight.Origin)."
          },
          "destination": {
            "type": "string",
            "description": "Destination airport or city (legacy Flight.Destination)."
          },
          "departureDate": {
            "type": "string",
            "format": "date",
            "description": "Departure date, formatted yyyy-MM-dd (legacy Flight.DepartureDate)."
          },
          "departureTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "Departure time, formatted HH:mm (legacy Flight.DepartureTime, a TimeSpan)."
          },
          "arrivalTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "Arrival time, formatted HH:mm (legacy Flight.ArrivalTime, a TimeSpan)."
          },
          "price": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Ticket price (legacy Flight.Price, a decimal). Displayed as currency in the legacy UI."
          },
          "availableSeats": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "Number of seats still available (legacy Flight.AvailableSeats)."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Record creation timestamp (legacy Flight.CreatedAt)."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error", "message"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Short error category, e.g. Bad Request, Not Found."
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message."
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
