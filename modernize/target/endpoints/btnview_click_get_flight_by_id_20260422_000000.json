{
  "openapi": "3.0.3",
  "info": {
    "title": "Airline Management API",
    "description": "API contract migrated from the AirlineManagement VB.NET WinForms legacy application. Covers the flight 'View' operation (BtnView_Click in FlightsForm).",
    "version": "1.0.0",
    "license": {
      "name": "Proprietary",
      "url": "https://example.com/license"
    }
  },
  "externalDocs": {
    "description": "Legacy source reference: Forms/FlightsForm.vb (BtnView_Click, GetSelectedFlightId, LoadFlights) and Forms/ViewFlightForm.vb",
    "url": "https://example.com/docs/airline-management"
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Flights",
      "description": "Flight schedule and details operations"
    }
  ],
  "paths": {
    "/flights/{id}": {
      "get": {
        "tags": ["Flights"],
        "summary": "Get flight details by ID",
        "description": "Retrieves the details of a single flight by its unique identifier. Maps to the legacy BtnView_Click handler, which takes the flight ID selected in the flights grid (GetSelectedFlightId) and opens the ViewFlightForm for that flight. The legacy form displays the flight number, route (origin to destination), departure date (yyyy-MM-dd), departure time (hh:mm), arrival time (hh:mm), price (currency) and available seats. If no flight is selected in the legacy UI, the request is not made; in the API this corresponds to a 400 response when the ID is invalid. If no flight exists with the given ID, the legacy form shows 'Flight not found.' and closes; in the API this corresponds to a 404 response.",
        "operationId": "getFlightById(AirlineManagement_VBNetLegacy.Forms.FlightsForm.FlightsForm.BtnView_Click.2.Object.EventArgs)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique identifier of the flight (legacy Flight.Id, selected from the flights grid 'Id' column).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "example": 101
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Flight details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "flightNumber", "origin", "destination", "departureDate", "departureTime", "arrivalTime", "price", "availableSeats", "createdAt"],
                  "properties": {
                    "id": {
                      "type": "integer",
                      "format": "int32",
                      "example": 101
                    },
                    "flightNumber": {
                      "type": "string",
                      "example": "AM-101"
                    },
                    "origin": {
                      "type": "string",
                      "example": "NYC"
                    },
                    "destination": {
                      "type": "string",
                      "example": "LAX"
                    },
                    "departureDate": {
                      "type": "string",
                      "format": "date",
                      "description": "Departure date (legacy format yyyy-MM-dd).",
                      "example": "2026-05-15"
                    },
                    "departureTime": {
                      "type": "string",
                      "description": "Departure time of day in HH:mm format (legacy format hh:mm).",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                      "example": "08:30"
                    },
                    "arrivalTime": {
                      "type": "string",
                      "description": "Arrival time of day in HH:mm format (legacy format hh:mm).",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                      "example": "11:45"
                    },
                    "price": {
                      "type": "number",
                      "format": "double",
                      "minimum": 0,
                      "description": "Ticket price (legacy Decimal, displayed with currency format).",
                      "example": 299.99
                    },
                    "availableSeats": {
                      "type": "integer",
                      "format": "int32",
                      "minimum": 0,
                      "description": "Number of seats still available. When 0, the legacy form disables booking ('Sold Out').",
                      "example": 42
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-01-10T09:00:00Z"
                    }
                  }
                },
                "example": {
                  "id": 101,
                  "flightNumber": "AM-101",
                  "origin": "NYC",
                  "destination": "LAX",
                  "departureDate": "2026-05-15",
                  "departureTime": "08:30",
                  "arrivalTime": "11:45",
                  "price": 299.99,
                  "availableSeats": 42,
                  "createdAt": "2026-01-10T09:00:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Bad request. The flight ID is not a valid integer (equivalent to no valid selection in the legacy UI).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Please select a flight."
                    },
                    "message": {
                      "type": "string",
                      "example": "The flight id must be a valid integer."
                    }
                  }
                },
                "example": {
                  "error": "Bad Request",
                  "message": "Please select a flight."
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized. Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Unauthorized"
                    },
                    "message": {
                      "type": "string",
                      "example": "Authentication is required."
                    }
                  }
                },
                "example": {
                  "error": "Unauthorized",
                  "message": "Authentication is required."
                }
              }
            }
          },
          "403": {
            "description": "Forbidden. The authenticated user is not allowed to view flights.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Forbidden"
                    },
                    "message": {
                      "type": "string",
                      "example": "You do not have permission to view this flight."
                    }
                  }
                },
                "example": {
                  "error": "Forbidden",
                  "message": "You do not have permission to view this flight."
                }
              }
            }
          },
          "404": {
            "description": "Flight not found. Legacy equivalent: 'Flight not found.' error message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Not Found"
                    },
                    "message": {
                      "type": "string",
                      "example": "Flight not found."
                    }
                  }
                },
                "example": {
                  "error": "Not Found",
                  "message": "Flight not found."
                }
              }
            }
          },
          "500": {
            "description": "Internal server error while retrieving the flight (legacy equivalent: unhandled database error).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Internal Server Error"
                    },
                    "message": {
                      "type": "string",
                      "example": "An unexpected error occurred."
                    }
                  }
                },
                "example": {
                  "error": "Internal Server Error",
                  "message": "An unexpected error occurred."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT bearer token. Assumption: replaces the legacy in-process SessionManager login session."
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
